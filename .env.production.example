# Copy to .env.production on the server. Never commit the real file.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_hex(32))"
# (hex keeps the Postgres password safe inside the database URL)
POSTGRES_PASSWORD=
JWT_SECRET=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Used if the main model hits a rate limit (limits are per model). Empty = off.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
REASONING_EFFORT=low
SAFETY_MODE=on
